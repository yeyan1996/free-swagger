{
  "description": "Swagger → API code",
  "keywords": [
    "swagger",
    "typescript",
    "jsdoc"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "github",
    "url": "https://github.com/yeyan1996/free-swagger"
  },
  "license": "MIT",
  "author": "yeyan1996",
  "scripts": {
    "ci:publish:pre": "pnpm publish -r --tag beta --force --no-git-checks",
    "precommit": "$CI && npm run lint",
    "build": "pnpm -r exec -- npm run build",
    "lint": "pnpm -r exec -- npm run lint",
    "test": "pnpm -r exec -- npm run test",
    "test:updateSnapshot": "pnpm -r exec -- npm run test -- --updateSnapshot",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "husky": "^9.0.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "@apidevtools/json-schema-ref-parser@9.0.7": "patches/@apidevtools__json-schema-ref-parser@9.0.7.patch"
    }
  }
}
